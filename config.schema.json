{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["groups"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"groups": {
			"description": "A group is picked first (weighted by fr), then one of its entries.",
			"type": "array",
			"items": { "$ref": "#/definitions/group" }
		}
	},
	"definitions": {
		"group": {
			"type": "object",
			"required": ["entries", "tooltip"],
			"additionalProperties": false,
			"properties": {
				"entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } },
				"tooltip": {
					"description": "Shown behind the question mark icon. Shared by every entry in the group.",
					"type": "string",
					"minLength": 1
				},
				"style": {
					"description": "Secondary text layout. Defaults to INLINE.",
					"enum": ["NEWLINE", "INLINE"]
				},
				"fr": {
					"description": "Weight against the other groups. Defaults to 1.",
					"type": "number",
					"minimum": 0
				}
			}
		},
		"entry": {
			"type": "object",
			"required": ["primary", "secondary", "link"],
			"additionalProperties": false,
			"properties": {
				"primary": { "type": "string" },
				"secondary": { "type": "string" },
				"link": { "type": "string", "pattern": "^https://" },
				"fr": {
					"description": "Weight against the other entries in the group. Defaults to 1.",
					"type": "number",
					"minimum": 0
				}
			}
		}
	}
}
